<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snap.Pages.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Snap.UI">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource ContentMaxWidth}"
            Padding="{StaticResource PageMargin}"
            ui:GridArea.Name="page"
            ui:GridArea.Inset="{StaticResource SpaceXxl}">
            <TextBlock
                Margin="{StaticResource PageHeaderMargin}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Layout"
                ui:GridProbe.Area="page"
                ui:GridProbe.Name="title" />

            <StackPanel Spacing="{StaticResource SpaceXs}" ui:GridProbe.Area="page" ui:GridProbe.Name="cards">
                <toolkit:SettingsCard Description="How much of the screen Left wide and Right wide take." Header="Wide width">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="WideBox" MinWidth="200" SelectionChanged="OnWideChanged" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Space around snapped windows. It scales with each display." Header="Gap between windows">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE740;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                        <TextBlock x:Name="GapText" MinWidth="48" VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider
                            x:Name="GapSlider"
                            Width="200"
                            VerticalAlignment="Center"
                            Maximum="40"
                            Minimum="0"
                            SmallChange="2"
                            StepFrequency="2"
                            ValueChanged="OnGapChanged" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
